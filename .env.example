# CHATBOTITALOC — variáveis de ambiente. NUNCA commite valores reais:
# configure-os no Coolify (Environment Variables) ou num .env local ignorado.

# Servidor
PORT=3000
LOG_LEVEL=info
# Banco PRÓPRIO do chatbot (não é o banco do Italoc).
DATABASE_URL="postgresql://usuario:senha@host:5432/chatbot"

# Meta / WhatsApp Cloud API
# App Secret do app da Meta (Configurações > Básico) — valida o X-Hub-Signature-256 do webhook.
META_APP_SECRET=""
# Texto livre que você escolhe e cola também no cadastro do webhook na Meta.
META_VERIFY_TOKEN=""
META_GRAPH_VERSION="v23.0"
# Chave que criptografa os tokens de acesso de cada número no banco: `openssl rand -base64 32`.
CHANNEL_TOKEN_KEY=""

# Italoc
# URL interna do Italoc (a rede do Coolify, ex.: http://italoc:3000).
ITALOC_BASE_URL=""
# Mesmo valor de CHATBOT_API_SECRET no Italoc: `openssl rand -base64 48`.
ITALOC_SHARED_SECRET=""
ITALOC_TIMEOUT_MS=15000

# IA (Anthropic)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
# low | medium | high — mais alto = respostas mais cuidadosas, mais caras e mais lentas.
AI_EFFORT="medium"
AI_TIMEOUT_MS=90000
AI_MAX_TOOL_ROUNDS=8
AI_HISTORY_MESSAGES=30

# Fila
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
WEBHOOK_RETENTION_DAYS=30
